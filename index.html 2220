<section class="page" id="p-fuel"><div class="head"><div><h2>Posto de abastecimento</h2><div class="muted">Tanque próprio</div></div></div><div class="card"><div class="line"><span>Estoque</span><b id="fuelStock"></b></div><div class="progress"><i id="fuelBar"></i></div><div class="line"><span>Capacidade</span><b id="fuelCapacity"></b></div><input class="input" id="fuelQty" type="number" value="10000"><button class="btn primary" id="buyFuel">Comprar diesel</button><button class="btn blue" id="expandFuel">Aumentar tanque</button></div><div class="card"><b>Compras automáticas abaixo de 40%</b><button class="btn switch" id="autoFuel"></button></div></section>
<section class="page" id="p-team"><div class="head"><div><h2>Funcionários</h2><div class="muted" id="teamCount"></div></div></div><div class="count-strip" id="teamTotals"></div><div class="tabs" id="teamTabs"></div><select id="teamSort"><option value="long">Mais tempo de casa</option><option value="short">Menos tempo de casa</option><option value="rating">Melhor avaliação</option></select><div id="team"></div></section>
<section class="page" id="p-rh"><div class="head"><div><h2>Recursos Humanos</h2><div class="muted">Contratação, férias e salários</div></div></div><div class="card"><b>Férias automáticas</b><button class="btn switch" id="autoVacation"></button></div><div id="rhSectors"></div></section>
<section class="page" id="p-finance"><div class="head"><div><h2>Financeiro</h2><div class="muted">Ganhos e gastos detalhados</div></div></div><div id="finance"></div></section>
<section class="page" id="p-bank"><div class="head"><div><h2>Banco e loja</h2><div class="muted">Crédito, investimentos, veículos e expansão</div></div></div><div class="tabs" id="bankTabs"><button class="tab active" data-bank="account">Conta</button><button class="tab" data-bank="credit">Crédito</button><button class="tab" data-bank="invest">Investir</button><button class="tab" data-bank="shop">Loja</button><button class="tab" data-bank="expand">Expansão</button></div><div id="bank"></div></section>
<section class="page" id="p-occurrences"><div class="head"><div><h2>Central de ocorrências</h2><div class="muted">Multas, panes, roubos e fiscalizações</div></div></div><select id="occFilter"><option value="all">Todas</option><option value="open">Pendentes</option><option value="resolved">Resolvidas</option></select><div id="occurrences"></div></section>
<section class="page" id="p-claims"><div class="head"><div><h2>Acidentes e sinistros</h2><div class="muted">Laudos e decisões</div></div></div><div id="claims"></div></section>
<section class="page" id="p-branches"><div class="head"><div><h2>Filiais</h2><div class="muted">Expanda sua rede logística</div></div></div><div id="branches"></div></section>
</main></div>
<div class="drawer-back" id="drawerBack"></div><aside class="drawer" id="drawer"><div class="head"><div><h3>ROTA FORTE</h3><div class="muted">Menu completo</div></div><button class="icon" id="menuClose">×</button></div><div id="menuLinks"></div><button class="menu" id="pause">⏸️ Pausar</button><button class="menu" id="export">📤 Exportar progresso</button><button class="menu" id="reset">🗑️ Reiniciar empresa</button></aside>
<nav class="bottom"><div><button data-go="home"><b>🏠</b>Início</button><button data-go="loads"><b>📦</b>Cargas</button><button data-go="logistics"><b>📡</b>Logística</button><button data-go="fleet"><b>🚛</b>Frota</button><button data-go="finance"><b>💳</b>Financeiro</button></div></nav>
<div class="modal-back" id="modalBack"><div class="modal" id="modal"></div></div>
<script>
(()=>{'use strict';
const $=id=>document.getElementById(id),money=n=>Math.round(Number(n)||0).toLocaleString('pt-BR'),clamp=(n,a=0,b=100)=>Math.max(a,Math.min(b,n));
const SAVE='rotaForteCleanV1',DAY_SECONDS=45,KM_L=2.4;
const partInfo={brakes:['🛑','Freios',120000,4800],engine:['⚙️','Motor',1000000,42000],transmission:['🔧','Câmbio',700000,24000],suspension:['🪛','Suspensão',250000,9500],axles:['🔩','Eixos',600000,18000],oil:['🛢️','Óleo',40000,1600],oilFilter:['🧴','Filtro de óleo',40000,750],airFilter:['💨','Filtro de ar',60000,900],fuelFilter:['⛽','Filtro de combustível',50000,1100],cooling:['❄️','Arrefecimento',350000,7200],electric:['💡','Elétrica',400000,6800],turbo:['🌪️','Turbina',500000,16000],clutch:['⚙️','Embreagem',300000,11000],differential:['🔩','Diferencial',650000,19000],battery:['🔋','Bateria',180000,2600],exhaust:['💨','Escapamento',450000,7000]};
const trailerInfo={brakes:['🛑','Freios',150000,4200],suspension:['🪛','Suspensão',300000,8000],axles:['🔩','Eixos',600000,15000],lighting:['💡','Iluminação',300000,2600],coupling:['🔗','Engate e quinta roda',500000,9000],floor:['🧱','Piso e estrutura',600000,12000],refrigeration:['🧊','Refrigeração',250000,18000]};
const truckModels=[['Scania R450',852000,1],['Volvo FH 500',850000,1.08],['Mercedes Actros',817000,1.16],['DAF XF',795000,1.24]],trailerModels=[['Baú',170000,1],['Sider',185000,1.04],['Graneleira',195000,1.07],['Refrigerada',280000,1.18],['Tanque',310000,1.22]];
const cities=['Juiz de Fora','Belo Horizonte','Rio de Janeiro','São Paulo','Vitória','Salvador','Brasília','Curitiba','Florianópolis','Goiânia','Campinas','Uberlândia','Porto Alegre','Recife','Fortaleza'];
const cargos=[['Seca','📦',1],['Refrigerada','🧊',1.35],['Perigosa','☣️',1.6],['Frágil','🥚',1.3],['Viva','🐄',1.45]];
const roles=['Motorista','Logística','Mecânico','Almoxarife','Borracheiro','Frentista','Lavador','Compras','Contador','Despachante'];
const salaries={Motorista:4200,Logística:5200,Mecânico:4800,Almoxarife:3300,Borracheiro:3800,Frentista:2800,Lavador:2600,Compras:4500,Contador:6200,Despachante:5000};
const names=['Ana Silva','Bruno Santos','Carlos Souza','Daniel Oliveira','Eduardo Lima','Fernanda Rocha','Gabriel Alves','Helena Costa','Igor Martins','Juliana Ribeiro','Lucas Ferreira','Márcia Gomes','Paulo Mendes','Renata Nunes','Tiago Carvalho'];
const freshInstalled=info=>Object.fromEntries(Object.keys(info).map(k=>[k,0])),freshStock=()=>Object.fromEntries(Object.keys(partInfo).map(k=>[k,200]));
function makeTruck(id,name='Volvo FH 500'){const m=truckModels.find(x=>x[0]===name)||truckModels[0];return{id,name:m[0],price:m[1],eff:m[2],plate:plate(),km:0,fuel:600,tank:600,status:'idle',driverId:null,trailerId:null,trip:null,remaining:0,installed:freshInstalled(partInfo),tires:Array.from({length:10},(_,i)=>({pos:i<2?'Direcional':'Trativo',installedKm:0,punctured:false})),history:[]}}
function makeTrailer(id,type='Baú'){const m=trailerModels.find(x=>x[0]===type)||trailerModels[0];return{id,name:`Carreta ${m[0]}`,type:m[0],price:m[1],eff:m[2],plate:'CRT-'+String(1000+id).padStart(4,'0'),km:0,status:'idle',truckId:null,installed:freshInstalled(trailerInfo),tires:Array.from({length:12},(_,i)=>({pos:`P${i+1}`,installedKm:0,punctured:false})),history:[]}}
function plate(){const l='ABCDEFGHIJKLMNOPQRSTUVWXYZ';return Array.from({length:3},()=>l[Math.floor(Math.random()*26)]).join('')+'-'+Math.floor(1000+Math.random()*9000)}
function initial(){const trucks=Array.from({length:12},(_,i)=>makeTruck(i+1,truckModels[i%4][0])),trailers=Array.from({length:12},(_,i)=>makeTrailer(i+1,trailerModels[i%5][0]));const workers=Array.from({length:24},(_,i)=>({id:i+1,name:names[i%names.length]+' '+(i+1),role:i<14?'Motorista':roles[1+(i-14)%9],salary:salaries[i<14?'Motorista':roles[1+(i-14)%9]],status:'available',hireAbs:0,rating:80+Math.floor(Math.random()*16),vacationDue:360}));return{version:1,cash:300000000,bank:0,day:1,month:1,year:2026,absDay:0,clock:DAY_SECONDS,paused:false,lastSaved:Date.now(),revenue:0,monthExpense:0,trips:0,nextLoad:1,nextTruck:13,nextTrailer:13,nextWorker:25,nextEvent:1,trucks,trailers,workers,loads:[],ledger:[],months:[],occurrences:[],claims:[],stock:freshStock(),tireStock:{Direcional:200,Trativo:300},fuelStock:1000000,fuelCapacity:1000000,diesel:6.1,auto:{dispatch:true,parts:true,tires:true,fuel:true,vacation:true,taxes:true,fines:true},garageCapacity:120,branches:['Juiz de Fora'],investments:[],loans:[]}}
let state;
function load(){try{state=JSON.parse(localStorage.getItem(SAVE))||initial()}catch(e){state=initial()}normalize();const elapsed=Math.floor((Date.now()-(state.lastSaved||Date.now()))/1000);if(!state.paused&&elapsed>2)advance(Math.min(elapsed,86400),true);fillLoads();save()}
function normalize(){const base=initial();state={...base,...state,auto:{...base.auto,...(state.auto||{})},stock:{...base.stock,...(state.stock||{})},tireStock:{...base.tireStock,...(state.tireStock||{})}};state.trucks.forEach(t=>{t.installed={...freshInstalled(partInfo),...(t.installed||{})};t.history=t.history||[];t.tires=t.tires||makeTruck(0).tires});state.trailers.forEach(t=>{t.installed={...freshInstalled(trailerInfo),...(t.installed||{})};t.history=t.history||[];t.tires=t.tires||makeTrailer(0).tires})}
function save(){state.lastSaved=Date.now();localStorage.setItem(SAVE,JSON.stringify(state));$('saveState').textContent='● salvo'}
function condition(v,info){const vals=Object.keys(info).map(k=>clamp(100-(v.km-(v.installed[k]||0))/info[k][2]*100));return vals.reduce((a,b)=>a+b,0)/vals.length}
function partCondition(v,k,info){return clamp(100-(v.km-(v.installed[k]||0))/info[k][2]*100)}
function tireCondition(v,t){const life=t.pos==='Trativo'?90000:110000;return t.punctured?0:clamp(100-(v.km-t.installedKm)/life*100)}
function minPart(v,info){return Object.keys(info).sort((a,b)=>partCondition(v,a,info)-partCondition(v,b,info))[0]}
function addLedger(text,value,category,qty=1){state.ledger.unshift({id:Date.now()+Math.random(),day:state.day,month:state.month,year:state.year,text,value,category,qty});if(value<0){state.monthExpense+=-value;state.cash+=value}else{state.revenue+=value;state.cash+=value}state.ledger=state.ledger.slice(0,3000)}
function monthTotals(month=state.month,year=state.year){const entries=state.ledger.filter(x=>Number(x.month)===Number(month)&&Number(x.year)===Number(year)),revenue=entries.filter(x=>x.value>0).reduce((s,x)=>s+Number(x.value||0),0),expenses=-entries.filter(x=>x.value<0).reduce((s,x)=>s+Number(x.value||0),0);return{revenue,expenses,net:revenue-expenses,entries}}
function generateLoad(){let from=Math.floor(Math.random()*cities.length),to;do to=Math.floor(Math.random()*cities.length);while(to===from);const km=200+Math.floor(Math.random()*1400),c=cargos[Math.floor(Math.random()*cargos.length)],weight=8+Math.floor(Math.random()*32);return{id:state.nextLoad++,from,to,km,type:c[0],icon:c[1],weight,pay:Math.round((km*13+weight*500)*c[2]),time:Math.max(8,Math.round(km/65)),created:state.absDay}}
function fillLoads(){state.loads=state.loads.filter(l=>state.absDay-l.created<4);while(state.loads.length<12)state.loads.push(generateLoad())}
function worker(id){return state.workers.find(w=>w.id===id)}
function dispatch(load){const d=state.workers.find(w=>w.role==='Motorista'&&w.status==='available'),t=state.trucks.find(x=>x.status==='idle'&&condition(x,partInfo)>15&&x.tires.every(p=>tireCondition(x,p)>0)),r=state.trailers.find(x=>x.status==='idle'&&condition(x,trailerInfo)>15&&x.tires.every(p=>tireCondition(x,p)>0)&&(load.type!=='Refrigerada'||x.type==='Refrigerada'));if(!d||!t||!r)return false;const liters=load.km/KM_L;if(t.fuel<liters)return false;d.status='trip';t.status='trip';r.status='trip';t.driverId=d.id;t.trailerId=r.id;r.truckId=t.id;t.trip={...load,weather:['☀️ Normal','🌧️ Chuva','🚧 Buracos','🌫️ Neblina'][Math.floor(Math.random()*4)]};t.remaining=load.time;state.loads=state.loads.filter(x=>x.id!==load.id);fillLoads();return true}
function finishTrip(t){const l=t.trip,r=state.trailers.find(x=>x.id===t.trailerId),d=worker(t.driverId);if(!l)return;t.km+=l.km;t.fuel=clamp(t.fuel-l.km/KM_L,0,t.tank);if(r)r.km+=l.km;let pay=Math.round(l.pay*t.eff*(r?.eff||1)),event='Viagem concluída',fine=0;const risk=Math.random();if(risk<.012){event='Pneu furado';const tires=Math.random()<.5?t.tires:r.tires;tires[Math.floor(Math.random()*tires.length)].punctured=true;addOccurrence('Pneu furado',t,d,0)}else if(risk<.02){event='Fiscalização e multa';fine=1200+Math.floor(Math.random()*2500);addOccurrence(event,t,d,fine)}else if(risk<.025){event='Roubo parcial da carga';const loss=Math.round(pay*.25);pay-=loss;addOccurrence(event,t,d,loss)}else if(risk<.03){event='Acidente de trânsito';const loss=Math.round(pay*.18);pay-=loss;const claim={id:state.nextEvent++,title:'Laudo pericial de acidente',status:'open',date:date(),truck:t.name,plate:t.plate,driver:d?.name||'—',cause:l.weather.includes('Buracos')?'Condição da estrada':'Causa em investigação',loss};state.claims.unshift(claim);addOccurrence(event,t,d,loss)};addLedger(`Frete ${cities[l.from]} → ${cities[l.to]}`,pay,'Fretes');state.trips++;const log={date:date(),km:l.km,event,weather:l.weather,driver:d?.name,fine};t.history.unshift(log);if(r)r.history.unshift(log);if(d){d.status='available';d.rating=clamp(d.rating+(fine?-2:.2))}t.status='idle';t.driverId=null;t.trip=null;t.remaining=0;t.trailerId=null;if(r){r.status='idle';r.truckId=null}checkVehicle(t,partInfo,false);if(r)checkVehicle(r,trailerInfo,true)}
function addOccurrence(type,t,d,value){state.occurrences.unshift({id:state.nextEvent++,type,status:'open',date:date(),truck:t.name,plate:t.plate,driver:d?.name||'—',value})}
function checkVehicle(v,info,trailer){if(Object.keys(info).some(k=>partCondition(v,k,info)<=0))v.status='maintenance';if(v.tires.some(p=>tireCondition(v,p)<=0))v.status='tires';if(v.status==='idle'&&(trailer?false:v.fuel<v.tank*.15))v.status='fuel'}
function automaticServices(){state.trucks.forEach(t=>serviceVehicle(t,partInfo,false));state.trailers.forEach(t=>serviceVehicle(t,trailerInfo,true))}
function serviceVehicle(v,info,trailer){if(v.status==='maintenance'){const k=minPart(v,info);if((state.stock[k]||0)>0&&state.workers.some(w=>w.role==='Mecânico')){state.stock[k]--;v.installed[k]=v.km;addLedger(`${info[k][1]} · ${v.plate}`,-info[k][3],'Manutenção');v.history.unshift({date:date(),km:0,event:`Trocado: ${info[k][1]}`,weather:'Garagem',driver:'Mecânico'});v.status='idle';checkVehicle(v,info,trailer)}}else if(v.status==='tires'){const p=v.tires.find(x=>tireCondition(v,x)<=0);if(p&&(state.tireStock[p.pos]||0)>0&&state.workers.some(w=>w.role==='Borracheiro')){state.tireStock[p.pos]--;p.installedKm=v.km;p.punctured=false;addLedger(`Pneu ${p.pos} · ${v.plate}`,-(p.pos==='Trativo'?1900:1600),'Pneus');v.history.unshift({date:date(),km:0,event:`Pneu ${p.pos} trocado`,weather:'Borracharia',driver:'Borracheiro'});v.status='idle';checkVehicle(v,info,trailer)}}else if(v.status==='fuel'&&!trailer){const need=v.tank-v.fuel;if(state.fuelStock>=need&&state.workers.some(w=>w.role==='Frentista')){state.fuelStock-=need;v.fuel=v.tank;v.status='idle'}}}
function buyers(){if(!state.workers.some(w=>w.role==='Compras'))return;if(state.auto.parts)Object.keys(partInfo).forEach(k=>{if(state.stock[k]<80){const q=200-state.stock[k],cost=q*partInfo[k][3];if(state.cash>=cost){state.stock[k]=200;addLedger(`${partInfo[k][1]} · ${q} un.`,-cost,'Peças',q)}}});if(state.auto.tires)Object.entries({Direcional:200,Trativo:300}).forEach(([k,target])=>{if(state.tireStock[k]<target*.4){const q=target-state.tireStock[k],unit=k==='Trativo'?1900:1600;if(state.cash>=q*unit){state.tireStock[k]=target;addLedger(`Pneu ${k} · ${q} un.`,-q*unit,'Pneus',q)}}});if(state.auto.fuel&&state.fuelStock<state.fuelCapacity*.4){const q=state.fuelCapacity-state.fuelStock,cost=q*state.diesel;if(state.cash>=cost){state.fuelStock=state.fuelCapacity;addLedger(`Diesel · ${money(q)} L`,-cost,'Combustível',q)}}}
function autoDispatch(){if(!state.auto.dispatch)return;let guard=0;while(guard++<50){const load=state.loads[0];if(!load||!dispatch(load))break}}
function advance(seconds,offline=false){for(let i=0;i<seconds;i++){if(state.paused)break;state.clock--;state.trucks.filter(t=>t.status==='trip').forEach(t=>{t.remaining--;if(t.remaining<=0)finishTrip(t)});if(i%3===0){automaticServices();autoDispatch()}if(state.clock<=0){state.clock=DAY_SECONDS;newDay()}}if(offline)save()}
function newDay(){const closingMonth=state.day>=30;state.absDay++;if(closingMonth)payroll();state.day++;if(state.day>30){closeMonth();state.day=1;state.month++;if(state.month>12){state.month=1;state.year++}}fillLoads();buyers();state.diesel=clamp(state.diesel*(.96+Math.random()*.09),4.5,9);if(state.auto.vacation)state.workers.filter(w=>state.absDay-w.hireAbs>=w.vacationDue&&w.status==='available').slice(0,Math.max(1,Math.ceil(state.workers.length*.03))).forEach(w=>{w.hireAbs=state.absDay;addLedger(`Férias · ${w.name}`,-Math.round(w.salary*1.333),'RH')});if(state.auto.fines&&state.workers.some(w=>w.role==='Despachante'))state.occurrences.filter(o=>o.status==='open'&&o.value>0).forEach(o=>{if(state.cash>=o.value){addLedger(`${o.type} · ${o.plate}`,-o.value,'Multas');o.status='resolved'}})}
function payroll(){const total=state.workers.reduce((s,w)=>s+w.salary,0);addLedger(`Folha de pagamento · ${state.workers.length} funcionários`,-total,'Folha',state.workers.length);if(state.auto.taxes&&state.workers.some(w=>w.role==='Contador'))addLedger('Impostos mensais',-Math.round(state.revenue*.08),'Impostos')}
function closeMonth(){const total=monthTotals(state.month,state.year);state.months.unshift({month:state.month,year:state.year,revenue:total.revenue,expenses:total.expenses,net:total.net,items:total.entries.filter(x=>x.value<0)});state.months=state.months.slice(0,12);state.revenue=0;state.monthExpense=0}
function date(){return`${String(state.day).padStart(2,'0')}/${String(state.month).padStart(2,'0')}/${state.year}`}
function status(v){return{idle:'Disponível',trip:'Em viagem',maintenance:'Aguardando oficina',tires:'Aguardando pneu',fuel:'Aguardando diesel'}[v.status]||v.status}
function go(page){document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));$(`p-${page}`)?.classList.add('active');closeDrawer();render(page);scrollTo(0,0)}
