window.dispatchById=id=>{const l=state.loads.find(x=>x.id===id);if(!dispatch(l))alert('Falta motorista, caminhão, carreta compatível, combustível ou manutenção.');save();render('loads')};
function renderLogistics(){$('autoDispatch').textContent=state.auto.dispatch?'ATIVADO':'DESATIVADO';$('trips').innerHTML=state.trucks.filter(t=>t.status==='trip').map(t=>`<div class="card"><b>${t.name} · ${t.plate}</b><div class="muted">${t.trip.icon} ${t.trip.type} → ${cities[t.trip.to]} · ${t.remaining}s</div><div class="progress"><i style="width:${clamp(100-t.remaining/t.trip.time*100)}%"></i></div></div>`).join('')||'<div class="empty">Nenhuma viagem em andamento.</div>'}
function vehicleCard(v,info,trailer=false){const c=condition(v,info);return`<div class="card"><div class="line"><div><div class="vehicle-title">${trailer?'🚚':'🚛'} ${v.name}</div><div class="muted">${v.plate} · ${money(v.km)} km</div></div><span class="badge">${status(v)}</span></div><div class="line"><span>Condição</span><b class="${c<25?'red':c<55?'yellow':'green'}">${c.toFixed(1)}%</b></div><div class="actions"><button class="btn blue" onclick="openVehicle('${trailer?'trailer':'truck'}',${v.id})">Detalhes e histórico</button></div></div>`}
function sorted(list,search,sort,info){list=list.filter(v=>`${v.name} ${v.plate} ${v.type||''}`.toLowerCase().includes(search.toLowerCase()));return list.sort((a,b)=>sort==='low'?a.km-b.km:sort==='condition'?condition(b,info)-condition(a,info):b.km-a.km)}
