window.openVehicle=(kind,id)=>{const trailer=kind==='trailer',v=(trailer?state.trailers:state.trucks).find(x=>x.id===id),info=trailer?trailerInfo:partInfo;$('modal').innerHTML=`<div class="head"><div><h3>${v.name}</h3><div class="muted">${v.plate} · ${money(v.km)} km</div></div><button class="icon" onclick="closeModal()">×</button></div><div class="parts">${Object.keys(info).map(k=>{const c=partCondition(v,k,info);return`<div class="part"><b>${info[k][0]} ${info[k][1]}</b><div class="${c<25?'red':c<55?'yellow':'green'}">${c.toFixed(2)}%</div><div class="muted">Vida: ${money(info[k][2])} km</div></div>`}).join('')}</div><div class="section">Pneus individuais</div>${v.tires.map((p,i)=>`<div class="line"><span>${i+1}. ${p.pos}</span><b>${tireCondition(v,p).toFixed(1)}%</b></div>`).join('')}<div class="section">Histórico</div>${v.history.slice(0,30).map(h=>`<div class="card"><b>${h.date} · ${h.event}</b><div class="muted">${h.km||0} km · ${h.weather||''} · ${h.driver||''}</div></div>`).join('')||'<div class="empty">Sem histórico.</div>'}`;$('modalBack').classList.add('open')};window.closeModal=()=>$('modalBack').classList.remove('open');
function renderWorkshop(){const q=$('workshopSearch').value.toLowerCase(),all=[...state.trucks.map(v=>[v,partInfo,false]),...state.trailers.map(v=>[v,trailerInfo,true])].filter(([v])=>`${v.name} ${v.plate}`.toLowerCase().includes(q));$('workshop').innerHTML=all.map(([v,info,tr])=>{const k=minPart(v,info),c=partCondition(v,k,info);return`<div class="card"><b>${v.name} · ${v.plate}</b><div class="muted">Pior item: ${info[k][1]} ${c.toFixed(1)}%</div><button class="btn primary" ${v.status==='trip'||state.stock[k]<=0?'disabled':''} onclick="replacePart('${tr?'trailer':'truck'}',${v.id},'${k}')">Trocar ${info[k][1]}</button></div>`}).join('')}
window.replacePart=(kind,id,k)=>{const tr=kind==='trailer',v=(tr?state.trailers:state.trucks).find(x=>x.id===id),info=tr?trailerInfo:partInfo;if(state.stock[k]<=0||v.status==='trip')return;state.stock[k]--;v.installed[k]=v.km;addLedger(`${info[k][1]} · ${v.plate}`,-info[k][3],'Manutenção');v.status='idle';save();render('workshop')};
function renderWarehouse(){$('autoParts').textContent=state.auto.parts?'ATIVADO':'DESATIVADO';$('warehouse').innerHTML=Object.keys(partInfo).map(k=>`<div class="card"><div class="line"><span>${partInfo[k][0]} ${partInfo[k][1]}</span><b>${state.stock[k]}/200</b></div><input class="input" id="q-${k}" type="number" value="1"><button class="btn primary" onclick="buyPart('${k}')">Comprar · R$ ${money(partInfo[k][3])} cada</button></div>`).join('')}
