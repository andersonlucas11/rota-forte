<section class="page" id="p-warehouse"><div class="head"><div><h2>Almoxarifado</h2><div class="muted">200 unidades de capacidade por peça</div></div></div><div class="card"><b>Compras automáticas abaixo de 40%</b><button class="btn switch" id="autoParts"></button></div><div id="warehouse"></div></section>
