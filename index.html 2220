function render(page='home'){renderTop();({home:renderHome,loads:renderLoads,logistics:renderLogistics,fleet:renderFleet,trailers:renderTrailers,workshop:renderWorkshop,warehouse:renderWarehouse,tires:renderTires,fuel:renderFuel,team:renderTeam,rh:renderRH,finance:renderFinance,bank:renderBank,occurrences:renderOccurrences,claims:renderClaims,branches:renderBranches}[page]||renderHome)()}
function renderTop(){$('topCash').textContent=money(state.cash);$('topDate').textContent='📅 '+date();$('pause').textContent=state.paused?'▶️ Continuar':'⏸️ Pausar'}
function renderHome(){const total=monthTotals();state.revenue=total.revenue;state.monthExpense=total.expenses;$('hCash').textContent='R$ '+money(state.cash);$('hRevenue').textContent='R$ '+money(total.revenue);$('hExpenses').textContent='R$ '+money(total.expenses);$('hTrips').textContent=money(state.trips);$('hRoad').textContent=`${state.trucks.filter(t=>t.status==='trip').length}/${state.trucks.length}`;$('hLevel').textContent=Math.floor(state.trips/20)+state.branches.length;$('alerts').innerHTML=state.occurrences.some(o=>o.status==='open')?`<div class="card alert" data-go="occurrences">🚨 Há ${state.occurrences.filter(o=>o.status==='open').length} ocorrência(s) pendente(s).</div>`:''}
