function renderFuel(){$('fuelStock').textContent=money(state.fuelStock)+' L';$('fuelCapacity').textContent=money(state.fuelCapacity)+' L';$('fuelBar').style.width=clamp(state.fuelStock/state.fuelCapacity*100)+'%';$('autoFuel').textContent=state.auto.fuel?'ATIVADO':'DESATIVADO';$('buyFuel').textContent=`Comprar diesel · R$ ${state.diesel.toFixed(2).replace('.',',')}/L`}
function renderTeam(){const sector=window.teamSector||'Todos',tabs=['Todos',...roles],roleCount=r=>r==='Todos'?state.workers.length:state.workers.filter(w=>w.role===r).length;$('teamTabs').innerHTML=tabs.map(x=>`<button class="tab ${x===sector?'active':''}" onclick="setTeam('${x}')">${x} (${roleCount(x)})</button>`).join('');$('teamTotals').innerHTML=`<div class="count-chip">Todos<b>${state.workers.length}</b></div>`+roles.map(r=>`<div class="count-chip">${r}<b>${roleCount(r)}</b></div>`).join('');let list=state.workers.filter(w=>sector==='Todos'||w.role===sector),sort=$('teamSort').value;list.sort((a,b)=>sort==='short'?b.hireAbs-a.hireAbs:sort==='rating'?b.rating-a.rating:a.hireAbs-b.hireAbs);$('teamCount').textContent=`Total: ${state.workers.length} funcionários · ${list.length} exibidos`;$('team').innerHTML=list.map(w=>`<div class="card"><div class="line"><b>${w.name}</b><span class="badge">${w.role}</span></div><div class="muted">${state.absDay-w.hireAbs} dias de empresa · avaliação ${w.rating.toFixed(0)}/100</div><div>Salário: R$ ${money(w.salary)}</div></div>`).join('')};window.setTeam=s=>{window.teamSector=s;renderTeam()};
function renderRH(){$('autoVacation').textContent=state.auto.vacation?'ATIVADO':'DESATIVADO';$('rhSectors').innerHTML=roles.map(role=>{const ws=state.workers.filter(w=>w.role===role);return`<div class="card"><div class="line"><b>${role}</b><span>${ws.length} pessoa(s)</span></div><div class="muted">Salário-base médio: R$ ${money(ws.reduce((s,w)=>s+w.salary,0)/(ws.length||1))}</div><div class="actions"><button class="btn" onclick="sectorSalary('${role}',100)">+ R$100</button><button class="btn" onclick="sectorSalary('${role}',-100)">− R$100</button><button class="btn primary" onclick="hire('${role}')">Contratar</button></div></div>`}).join('')};window.sectorSalary=(r,d)=>{state.workers.filter(w=>w.role===r).forEach(w=>w.salary=Math.max(1500,w.salary+d));save();render('rh')};window.hire=r=>{const id=state.nextWorker++;state.workers.push({id,name:names[id%names.length]+' '+id,role:r,salary:salaries[r],status:'available',hireAbs:state.absDay,rating:80,vacationDue:360});save();render('rh')};
function renderFinance(){const total=monthTotals();state.revenue=total.revenue;state.monthExpense=total.expenses;const current=`<div class="grid"><div class="card kpi"><span>Receita deste mês</span><b class="green">R$ ${money(total.revenue)}</b></div><div class="card kpi"><span>Despesas deste mês</span><b class="red">R$ ${money(total.expenses)}</b></div><div class="card kpi"><span>Lucro líquido</span><b class="${total.net>=0?'green':'red'}">R$ ${money(total.net)}</b></div></div><div class="card"><b>Entradas do mês atual</b>${total.entries.filter(x=>x.value>0).slice(0,30).map(x=>`<div class="line"><span>${x.text}</span><b class="green">+ R$ ${money(x.value)}</b></div>`).join('')||'<div class="muted">Ainda não houve receita neste mês.</div>'}</div>`;$('finance').innerHTML=current+state.months.map((m,i)=>`<div class="card" onclick="toggleMonth(${i})"><div class="line"><b>${String(m.month).padStart(2,'0')}/${m.year}</b><b class="${m.net>=0?'green':'red'}">R$ ${money(m.net)}</b></div><div class="muted">Bruto R$ ${money(m.revenue)} · despesas R$ ${money(m.expenses)} · toque para detalhar</div><div id="month-${i}" style="display:none">${m.items.map(x=>`<div class="line"><span>${x.text}${x.qty>1?' · '+x.qty+' un.':''}</span><b class="red">R$ ${money(-x.value)}</b></div>`).join('')}</div></div>`).join('')};window.toggleMonth=i=>{const e=$(`month-${i}`);e.style.display=e.style.display==='none'?'block':'none'};
let bankView='account';function renderBank(){document.querySelectorAll('[data-bank]').forEach(b=>b.classList.toggle('active',b.dataset.bank===bankView));if(bankView==='account')$('bank').innerHTML=`<div class="card"><div class="line"><span>Saldo bancário</span><b>R$ ${money(state.bank)}</b></div><input class="input" id="bankValue" type="number" value="100000"><button class="btn primary" onclick="transferBank(1)">Depositar</button><button class="btn blue" onclick="transferBank(-1)">Sacar</button></div>`;if(bankView==='credit')$('bank').innerHTML=`<div class="card"><input class="input" id="creditValue" type="number" value="1000000"><select id="creditTerm"><option>12</option><option>24</option><option>36</option><option>48</option></select><button class="btn primary" onclick="takeLoan()">Contratar empréstimo</button></div>${state.loans.map(l=>`<div class="card">Saldo R$ ${money(l.balance)} · ${l.remaining} parcelas</div>`).join('')}`;if(bankView==='invest')$('bank').innerHTML=`<div class="card"><input class="input" id="investValue" type="number" value="100000"><button class="btn primary" onclick="invest()">Investir a 0,8% ao mês</button></div>${state.investments.map(x=>`<div class="card">Aplicado R$ ${money(x.value)} · mês ${x.month}/${x.year}</div>`).join('')}`;if(bankView==='shop')$('bank').innerHTML=[...truckModels.map((m,i)=>`<div class="card"><b>🚛 ${m[0]}</b><div>R$ ${money(m[1])}</div><input class="input" id="buy-truck-${i}" type="number" value="1"><button class="btn primary" onclick="buyVehicle('truck',${i})">Comprar quantidade</button></div>`),...trailerModels.map((m,i)=>`<div class="card"><b>🚚 Carreta ${m[0]}</b><div>R$ ${money(m[1])}</div><input class="input" id="buy-trailer-${i}" type="number" value="1"><button class="btn primary" onclick="buyVehicle('trailer',${i})">Comprar quantidade</button></div>`)].join('');if(bankView==='expand')$('bank').innerHTML=`<div class="card"><b>Capacidade da garagem: ${state.garageCapacity}</b><div class="muted">Adiciona 50 vagas.</div><button class="btn primary" onclick="expandGarage()">Expandir por R$ 2.000.000</button></div>`}
window.transferBank=d=>{const v=Math.max(0,+$('bankValue').value||0);if(d>0&&state.cash>=v){state.cash-=v;state.bank+=v}else if(d<0&&state.bank>=v){state.bank-=v;state.cash+=v}save();render('bank')};window.takeLoan=()=>{const v=+$('creditValue').value||0,n=+$('creditTerm').value;if(v<10000)return;state.bank+=v;state.loans.push({balance:Math.round(v*1.18),remaining:n});save();render('bank')};window.invest=()=>{const v=+$('investValue').value||0;if(state.bank<v)return;state.bank-=v;state.investments.push({value:v,month:state.month,year:state.year});save();render('bank')};window.buyVehicle=(kind,i)=>{const tr=kind==='trailer',m=(tr?trailerModels:truckModels)[i],q=Math.max(1,+$(`buy-${kind}-${i}`).value||1),cost=m[1]*q;if(state.cash<cost||!tr&&state.trucks.length+q>state.garageCapacity)return;for(let n=0;n<q;n++)tr?state.trailers.push(makeTrailer(state.nextTrailer++,m[0])):state.trucks.push(makeTruck(state.nextTruck++,m[0]));addLedger(`${q} ${tr?'carreta(s)':'caminhão(ões)'} ${m[0]}`,-cost,'Frota',q);save();render('bank')};window.expandGarage=()=>{if(state.cash<2000000)return;state.garageCapacity+=50;addLedger('Expansão da garagem',-2000000,'Expansão');save();render('bank')};
function renderOccurrences(){const f=$('occFilter').value,list=state.occurrences.filter(o=>f==='all'||o.status===f);$('occurrences').innerHTML=list.map(o=>`<div class="card ${o.status==='open'?'alert':''}"><div class="line"><b>🚨 ${o.type}</b><span class="badge">${o.status==='open'?'Pendente':'Resolvida'}</span></div><div class="muted">${o.date} · ${o.truck} · ${o.plate} · ${o.driver}</div>${o.value?`<div>Valor: R$ ${money(o.value)}</div>`:''}<button class="btn primary" onclick="resolveOcc(${o.id})">Marcar resolvida</button></div>`).join('')||'<div class="empty">Nenhuma ocorrência.</div>'};window.resolveOcc=id=>{const o=state.occurrences.find(x=>x.id===id);if(o)o.status='resolved';save();render('occurrences')};
function renderClaims(){$('claims').innerHTML=state.claims.map(c=>`<div class="card"><div class="line"><b>${c.title}</b><span class="badge">${c.status==='open'?'Aberto':'Encerrado'}</span></div><div class="muted">${c.date} · ${c.truck} · ${c.plate} · ${c.driver}</div><div>Causa: ${c.cause}</div><div>Prejuízo estimado: R$ ${money(c.loss)}</div><button class="btn primary" ${c.status!=='open'?'disabled':''} onclick="closeClaim(${c.id})">Pagar reparo e encerrar</button></div>`).join('')||'<div class="empty">Nenhum sinistro registrado.</div>'};window.closeClaim=id=>{const c=state.claims.find(x=>x.id===id);if(!c||c.status!=='open'||state.cash<c.loss)return;addLedger(`Sinistro · ${c.plate}`,-c.loss,'Sinistros');c.status='closed';save();render('claims')}
function renderBranches(){$('branches').innerHTML=cities.map(c=>`<div class="card"><div class="line"><b>🏢 ${c}</b><span class="badge">${state.branches.includes(c)?'Aberta':'Fechada'}</span></div><button class="btn primary" ${state.branches.includes(c)?'disabled':''} onclick="openBranch('${c}')">Abrir por R$ 5.000.000</button></div>`).join('')};window.openBranch=c=>{if(state.cash<5000000||state.branches.includes(c))return;state.branches.push(c);addLedger(`Abertura da filial ${c}`,-5000000,'Filiais');save();render('branches')};
function toggleAuto(k){state.auto[k]=!state.auto[k];save();render(document.querySelector('.page.active').id.replace('p-',''))}
const menu=[['home','🏠 Visão geral'],['loads','📦 Mercado de cargas'],['logistics','📡 Logística'],['fleet','🚛 Garagem'],['trailers','🚚 Carretas'],['workshop','🔧 Oficina'],['warehouse','📦 Almoxarifado'],['tires','🛞 Borracharia'],['fuel','⛽ Posto'],['team','👷 Funcionários'],['rh','🧑‍💼 RH'],['finance','💳 Financeiro'],['bank','🏦 Banco e loja'],['occurrences','🚨 Ocorrências'],['claims','🚑 Sinistros'],['branches','🏢 Filiais']];$('menuLinks').innerHTML=menu.map(([p,l])=>`<button class="menu" data-go="${p}">${l}</button>`).join('');
document.addEventListener('click',e=>{const g=e.target.closest('[data-go]');if(g)go(g.dataset.go)});$('menuOpen').onclick=openDrawer;$('menuClose').onclick=closeDrawer;$('drawerBack').onclick=closeDrawer;$('modalBack').onclick=e=>{if(e.target===$('modalBack'))window.closeModal()};$('autoDispatch').onclick=()=>toggleAuto('dispatch');$('autoParts').onclick=()=>toggleAuto('parts');$('autoTires').onclick=()=>toggleAuto('tires');$('autoFuel').onclick=()=>toggleAuto('fuel');$('autoVacation').onclick=()=>toggleAuto('vacation');$('fleetSearch').oninput=renderFleet;$('fleetSort').onchange=renderFleet;$('trailerSearch').oninput=renderTrailers;$('trailerSort').onchange=renderTrailers;$('workshopSearch').oninput=renderWorkshop;$('teamSort').onchange=renderTeam;$('occFilter').onchange=renderOccurrences;document.querySelectorAll('[data-bank]').forEach(b=>b.onclick=()=>{bankView=b.dataset.bank;renderBank()});$('buyFuel').onclick=()=>{const q=Math.min(state.fuelCapacity-state.fuelStock,Math.max(1,+$('fuelQty').value||1)),cost=q*state.diesel;if(state.cash>=cost){state.fuelStock+=q;addLedger(`Diesel · ${money(q)} L`,-cost,'Combustível',q);save();render('fuel')}};$('expandFuel').onclick=()=>{const cost=5000000;if(state.cash>=cost){state.fuelCapacity+=500000;addLedger('Ampliação do tanque +500.000 L',-cost,'Expansão');save();render('fuel')}};$('pause').onclick=()=>{state.paused=!state.paused;save();renderTop()};$('export').onclick=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(state)],{type:'application/json'}));a.download='rota-forte-backup.json';a.click()};$('reset').onclick=()=>{if(confirm('Apagar todo o progresso e começar novamente?')){localStorage.removeItem(SAVE);state=initial();fillLoads();save();go('home')}};
load();render();setInterval(()=>{advance(1);renderTop();if(document.querySelector('.page.active')?.id==='p-home')renderHome();save()},1000);document.addEventListener('visibilitychange',()=>{if(document.hidden)save();else{const e=Math.floor((Date.now()-state.lastSaved)/1000);if(!state.paused)advance(Math.min(e,86400),true);render(document.querySelector('.page.active')?.id.replace('p-','')||'home')}});
})();
</script></body></html>
