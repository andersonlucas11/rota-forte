<body><div class="app">
<header class="top"><div class="top-left"><span class="logo">🚛</span><div class="brand">ROTA FORTE<small>Base limpa · V1.1</small></div></div><div class="top-right"><div class="money">R$ <span id="topCash">0</span><small id="topDate">01/01/2026</small></div><button class="icon" id="menuOpen">☰</button></div></header>
